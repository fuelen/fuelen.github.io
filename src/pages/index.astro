---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="intro" class="py-8 sm:py-10">
      <p class="text-muted-foreground text-lg">
        Software engineer working with Elixir.
      </p>
    </section>

    <section id="articles" class="pb-10">
      <div class="border-border flex items-end justify-between border-b pb-4">
        <h2 class="text-sm font-semibold tracking-[0.12em] uppercase">
          Articles
        </h2>
        <span class="text-muted-foreground text-sm">{sortedPosts.length}</span>
      </div>
      <ul>
        {sortedPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
